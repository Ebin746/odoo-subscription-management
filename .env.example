# Database (Supabase PostgreSQL)
# Prisma connection string (Supabase Transaction pooler or direct connection)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (for Prisma CLI migrations & db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Backend Server
PORT=5000
NODE_ENV=development

# JWT Authentication (P1)
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Application URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Mailer Settings (SMTP)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-pass"
MAIL_FROM="noreply@brightloop.com"

# Gmail SMTP (takes precedence over SMTP_* when both set; use a Gmail app password)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=

# Redis (optional). Start it with: docker compose up -d redis
# Without REDIS_URL everything still works, just without background queues, caching and shared rate limits.
REDIS_URL="redis://localhost:6379"
# When daily jobs run (billing, auto-close). Cron syntax, server time. Default: every day at 02:00.
DAILY_JOB_CRON="0 2 * * *"
# Requests allowed per 15 minutes on login/forgot-password (sign-up and reset use a share of it)
AUTH_RATE_MAX=100
