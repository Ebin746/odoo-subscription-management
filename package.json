{
  "name": "odoo-subscription-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "tsx backend/src/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "seed:catalog": "tsx backend/src/modules/catalog/seed.ts",
    "seed:billing": "tsx backend/src/modules/billing/seed.ts",
    "seed:payments": "tsx backend/src/modules/payments/seed.ts",
    "seed:all": "tsx backend/src/modules/catalog/seed.ts && tsx backend/src/modules/billing/seed.ts && tsx backend/src/modules/payments/seed.ts"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
